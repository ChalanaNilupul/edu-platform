generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum WorkspaceType {
  TEACHER
  INSTITUTE
}

enum WorkspaceRole {
  OWNER
  ADMIN
  BRANCH_MANAGER
  TEACHER
  STUDENT
  PARENT
}

enum MembershipStatus {
  ACTIVE
  SUSPENDED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

enum StudentStatus {
  ACTIVE
  INACTIVE
  GRADUATED
  WITHDRAWN
}

enum StudentGender {
  MALE
  FEMALE
  OTHER
}

enum GuardianRelationship {
  FATHER
  MOTHER
  GUARDIAN
  OTHER
}

enum ClassStatus {
  ACTIVE
  ARCHIVED
}

enum EnrollmentStatus {
  ACTIVE
  COMPLETED
  WITHDRAWN
}

enum SubjectStatus {
  ACTIVE
  ARCHIVED
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum BillingPeriod {
  MONTHLY
  ONE_TIME
}

enum FeePlanStatus {
  ACTIVE
  ARCHIVED
}

enum FeeStatus {
  UNPAID
  PARTIAL
  PAID
  VOID
}

enum PaymentMethod {
  CASH
  BANK
}

enum AuditEventType {
  USER_REGISTERED
  LOGIN_SUCCEEDED
  LOGIN_FAILED
  EMAIL_VERIFIED
  EMAIL_VERIFICATION_RESENT
  PASSWORD_RESET_REQUESTED
  PASSWORD_RESET_COMPLETED
  WORKSPACE_CREATED
  WORKSPACE_SWITCHED
  MEMBER_ROLE_CHANGED
  MEMBER_REMOVED
  INVITATION_CREATED
  INVITATION_REVOKED
  INVITATION_ACCEPTED
  STUDENT_CREATED
  STUDENT_UPDATED
  STUDENT_STATUS_CHANGED
  GUARDIAN_CREATED
  GUARDIAN_UPDATED
  GUARDIAN_UNLINKED
  GUARDIAN_DELETED
  STUDENTS_IMPORTED
  CLASS_CREATED
  CLASS_UPDATED
  CLASS_DELETED
  STUDENT_ENROLLED
  ENROLLMENT_UPDATED
  TEACHER_PROFILE_CREATED
  TEACHER_PROFILE_UPDATED
  CLASS_TEACHER_ASSIGNED
  CLASS_TEACHER_PRIMARY_CHANGED
  CLASS_TEACHER_REMOVED
  SUBJECT_CREATED
  SUBJECT_UPDATED
  SUBJECT_ARCHIVED
  SUBJECT_DELETED
  CLASS_SUBJECTS_CHANGED
  CLASS_SCHEDULE_SLOT_CREATED
  CLASS_SCHEDULE_SLOT_UPDATED
  CLASS_SCHEDULE_SLOT_DELETED
  ATTENDANCE_RECORDED
  ATTENDANCE_UPDATED
  FEE_PLAN_CREATED
  FEE_PLAN_UPDATED
  FEE_PLAN_ARCHIVED
  STUDENT_FEES_GENERATED
  STUDENT_FEE_CREATED
  STUDENT_FEE_UPDATED
  STUDENT_FEE_VOIDED
  PAYMENT_RECORDED
  PAYMENT_DELETED
}

model User {
  id              String    @id @default(uuid())
  email           String    @unique
  passwordHash    String    @map("password_hash")
  firstName       String    @map("first_name")
  lastName        String?   @map("last_name")
  emailVerifiedAt DateTime? @map("email_verified_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  memberships             Membership[]
  sessions                Session[]
  invitationsSent         WorkspaceInvitation[]    @relation("InvitationInvitedBy")
  invitationsAccepted     WorkspaceInvitation[]    @relation("InvitationAcceptedBy")
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]

  @@map("users")
}

model Workspace {
  id        String        @id @default(uuid())
  name      String
  type      WorkspaceType
  currency  String        @default("LKR")
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")

  memberships        Membership[]
  invitations        WorkspaceInvitation[]
  students           Student[]
  guardians          Guardian[]
  studentGuardians   StudentGuardian[]
  classes            Class[]
  enrollments        Enrollment[]
  teacherProfiles    TeacherProfile[]
  classTeachers      ClassTeacher[]
  subjects           Subject[]
  classSubjects      ClassSubject[]
  scheduleSlots      ClassScheduleSlot[]
  attendanceSessions AttendanceSession[]
  attendanceRecords  AttendanceRecord[]
  feePlans           FeePlan[]
  studentFees        StudentFee[]
  payments           Payment[]
  counters           WorkspaceCounter[]
  activeSessions     Session[]             @relation("SessionActiveWorkspace")

  @@map("workspaces")
}

model Student {
  id           String         @id @default(uuid())
  workspaceId  String         @map("workspace_id")
  studentCode  String?        @map("student_code")
  firstName    String         @map("first_name")
  lastName     String?        @map("last_name")
  dateOfBirth  DateTime?      @map("date_of_birth") @db.Date
  gender       StudentGender?
  email        String?
  phone        String?
  addressLine1 String?        @map("address_line1")
  addressLine2 String?        @map("address_line2")
  city         String?
  district     String?
  postalCode   String?        @map("postal_code")
  school       String?
  grade        String?
  status       StudentStatus  @default(ACTIVE)
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  guardians         StudentGuardian[]
  enrollments       Enrollment[]
  attendanceRecords AttendanceRecord[]
  fees              StudentFee[]

  @@unique([workspaceId, studentCode])
  @@index([workspaceId, status])
  @@index([workspaceId, firstName, lastName])
  @@map("students")
}

model Guardian {
  id           String               @id @default(uuid())
  workspaceId  String               @map("workspace_id")
  firstName    String               @map("first_name")
  lastName     String?              @map("last_name")
  relationship GuardianRelationship
  email        String?
  phone        String?
  occupation   String?
  addressLine1 String?              @map("address_line1")
  addressLine2 String?              @map("address_line2")
  city         String?
  district     String?
  postalCode   String?              @map("postal_code")
  createdAt    DateTime             @default(now()) @map("created_at")
  updatedAt    DateTime             @updatedAt @map("updated_at")

  workspace Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  students  StudentGuardian[]

  @@index([workspaceId, lastName, firstName])
  @@map("guardians")
}

model StudentGuardian {
  id          String   @id @default(uuid())
  workspaceId String   @map("workspace_id")
  studentId   String   @map("student_id")
  guardianId  String   @map("guardian_id")
  isPrimary   Boolean  @default(false) @map("is_primary")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  student   Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  guardian  Guardian  @relation(fields: [guardianId], references: [id], onDelete: Cascade)

  @@unique([studentId, guardianId])
  @@index([workspaceId])
  @@index([guardianId])
  @@map("student_guardians")
}

model Class {
  id          String      @id @default(uuid())
  workspaceId String      @map("workspace_id")
  name        String
  grade       String?
  description String?
  capacity    Int?
  status      ClassStatus @default(ACTIVE)
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  workspace          Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  enrollments        Enrollment[]
  teachers           ClassTeacher[]
  subjects           ClassSubject[]
  schedule           ClassScheduleSlot[]
  attendanceSessions AttendanceSession[]
  feePlans           FeePlan[]
  fees               StudentFee[]

  @@unique([workspaceId, name])
  @@index([workspaceId, status])
  @@map("classes")
}

/// One row per enrollment period. Ending an enrollment closes the row, so
/// re-enrolling later inserts a new one and the history stays intact.
model Enrollment {
  id          String           @id @default(uuid())
  workspaceId String           @map("workspace_id")
  studentId   String           @map("student_id")
  classId     String           @map("class_id")
  status      EnrollmentStatus @default(ACTIVE)
  enrolledAt  DateTime         @default(now()) @map("enrolled_at") @db.Date
  endedAt     DateTime?        @map("ended_at") @db.Date
  notes       String?
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  student   Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  class     Class     @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@index([workspaceId, classId, status])
  @@index([workspaceId, studentId])
  @@map("enrollments")
}

/// One row per teaching assignment period. Removing a teacher ends the row,
/// so reassigning later inserts a new one and the history stays intact.
model ClassTeacher {
  id           String    @id @default(uuid())
  workspaceId  String    @map("workspace_id")
  classId      String    @map("class_id")
  membershipId String    @map("membership_id")
  isPrimary    Boolean   @default(false) @map("is_primary")
  assignedAt   DateTime  @default(now()) @map("assigned_at") @db.Date
  endedAt      DateTime? @map("ended_at") @db.Date
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  workspace  Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  class      Class      @relation(fields: [classId], references: [id], onDelete: Cascade)
  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@index([workspaceId, classId])
  @@index([workspaceId, membershipId])
  @@map("class_teachers")
}

/// Workspace-level catalogue entry; archived subjects stay linked to their
/// classes for history but drop out of pickers.
model Subject {
  id          String        @id @default(uuid())
  workspaceId String        @map("workspace_id")
  name        String
  code        String?
  description String?
  status      SubjectStatus @default(ACTIVE)
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  workspace  Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  classLinks ClassSubject[]
  schedule   ClassScheduleSlot[]

  @@unique([workspaceId, name])
  @@unique([workspaceId, code])
  @@index([workspaceId, status])
  @@map("subjects")
}

/// One row per subject a class covers; a class can carry several subjects.
model ClassSubject {
  id          String   @id @default(uuid())
  workspaceId String   @map("workspace_id")
  classId     String   @map("class_id")
  subjectId   String   @map("subject_id")
  createdAt   DateTime @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  class     Class     @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject   Subject   @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([classId, subjectId])
  @@index([workspaceId, subjectId])
  @@map("class_subjects")
}

/// Recurring weekly timetable slot. Times are minutes from midnight; the
/// migration enforces non-overlap per class and per teacher with exclusion
/// constraints.
model ClassScheduleSlot {
  id           String    @id @default(uuid())
  workspaceId  String    @map("workspace_id")
  classId      String    @map("class_id")
  subjectId    String    @map("subject_id")
  membershipId String?   @map("membership_id")
  dayOfWeek    DayOfWeek @map("day_of_week")
  startMinutes Int       @map("start_minutes")
  endMinutes   Int       @map("end_minutes")
  room         String?
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  workspace  Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  class      Class       @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject    Subject     @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  membership Membership? @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@index([workspaceId, classId, dayOfWeek, startMinutes], map: "class_schedule_slots_class_time_idx")
  @@index([workspaceId, membershipId, dayOfWeek, startMinutes], map: "class_schedule_slots_teacher_time_idx")
  @@map("class_schedule_slots")
}

/// One register per class per calendar day. A session only exists once a
/// register has been saved, so missing dates are simply unmarked days.
model AttendanceSession {
  id                     String   @id @default(uuid())
  workspaceId            String   @map("workspace_id")
  classId                String   @map("class_id")
  sessionDate            DateTime @map("session_date") @db.Date
  recordedByMembershipId String?  @map("recorded_by_membership_id")
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")

  workspace  Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  class      Class              @relation(fields: [classId], references: [id], onDelete: Cascade)
  recordedBy Membership?        @relation(fields: [recordedByMembershipId], references: [id], onDelete: SetNull)
  records    AttendanceRecord[]

  @@unique([classId, sessionDate], map: "attendance_sessions_class_date_key")
  @@index([workspaceId, sessionDate])
  @@map("attendance_sessions")
}

/// One status per student per session; the note is optional context such as
/// "arrived 10 minutes late" or a guardian phone call.
model AttendanceRecord {
  id          String           @id @default(uuid())
  workspaceId String           @map("workspace_id")
  sessionId   String           @map("session_id")
  studentId   String           @map("student_id")
  status      AttendanceStatus
  note        String?
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  workspace Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  session   AttendanceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  student   Student           @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([sessionId, studentId], map: "attendance_records_session_student_key")
  @@index([workspaceId, studentId])
  @@map("attendance_records")
}

/// Reusable fee definition. A class-scoped plan bills that class's active
/// enrollments; a plan without a class bills every active student once.
model FeePlan {
  id            String        @id @default(uuid())
  workspaceId   String        @map("workspace_id")
  classId       String?       @map("class_id")
  name          String
  description   String?
  amount        Decimal       @db.Decimal(12, 2)
  billingPeriod BillingPeriod @default(MONTHLY) @map("billing_period")
  dueDay        Int           @default(1) @map("due_day")
  status        FeePlanStatus @default(ACTIVE)
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  workspace Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  class     Class?       @relation(fields: [classId], references: [id], onDelete: SetNull)
  fees      StudentFee[]

  @@unique([workspaceId, name])
  @@index([workspaceId, status])
  @@index([workspaceId, classId])
  @@map("fee_plans")
}

/// One amount owed by a student, either generated from a plan for a month or
/// entered manually. Payments are the ledger; paid_amount and status are
/// cached totals recalculated inside the payment transaction.
model StudentFee {
  id                    String    @id @default(uuid())
  workspaceId           String    @map("workspace_id")
  studentId             String    @map("student_id")
  feePlanId             String?   @map("fee_plan_id")
  classId               String?   @map("class_id")
  description           String
  amount                Decimal   @db.Decimal(12, 2)
  paidAmount            Decimal   @default(0) @map("paid_amount") @db.Decimal(12, 2)
  status                FeeStatus @default(UNPAID)
  periodMonth           DateTime? @map("period_month") @db.Date
  dueDate               DateTime  @map("due_date") @db.Date
  note                  String?
  createdByMembershipId String?   @map("created_by_membership_id")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  workspace Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  student   Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  feePlan   FeePlan?    @relation(fields: [feePlanId], references: [id], onDelete: SetNull)
  class     Class?      @relation(fields: [classId], references: [id], onDelete: SetNull)
  createdBy Membership? @relation("StudentFeeCreatedBy", fields: [createdByMembershipId], references: [id], onDelete: SetNull)
  payments  Payment[]

  @@unique([studentId, feePlanId, periodMonth], map: "student_fees_plan_period_key")
  @@index([workspaceId, status])
  @@index([workspaceId, studentId])
  @@index([workspaceId, periodMonth])
  @@map("student_fees")
}

/// Money received against a student fee. Deleting a payment is the correction
/// path; the parent fee's cached paid amount is recalculated with it.
model Payment {
  id                     String        @id @default(uuid())
  workspaceId            String        @map("workspace_id")
  studentFeeId           String        @map("student_fee_id")
  receiptNumber          Int           @map("receipt_number")
  amount                 Decimal       @db.Decimal(12, 2)
  method                 PaymentMethod
  paidAt                 DateTime      @map("paid_at") @db.Date
  reference              String?
  note                   String?
  recordedByMembershipId String?       @map("recorded_by_membership_id")
  createdAt              DateTime      @default(now()) @map("created_at")
  updatedAt              DateTime      @updatedAt @map("updated_at")

  workspace  Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  studentFee StudentFee  @relation(fields: [studentFeeId], references: [id], onDelete: Cascade)
  recordedBy Membership? @relation("PaymentRecordedBy", fields: [recordedByMembershipId], references: [id], onDelete: SetNull)

  @@unique([workspaceId, receiptNumber])
  @@index([workspaceId, studentFeeId])
  @@index([workspaceId, paidAt])
  @@map("payments")
}

/// Monotonic counters scoped to a workspace. Receipt numbers are drawn from the
/// payment_receipt counter so a deleted payment never releases its number.
model WorkspaceCounter {
  workspaceId String @map("workspace_id")
  key         String
  value       Int

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@id([workspaceId, key])
  @@map("workspace_counters")
}

model Membership {
  id          String           @id @default(uuid())
  userId      String           @map("user_id")
  workspaceId String           @map("workspace_id")
  role        WorkspaceRole    @default(TEACHER)
  status      MembershipStatus @default(ACTIVE)
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  user      User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)

  teacherProfile     TeacherProfile?
  classAssignments   ClassTeacher[]
  scheduleSlots      ClassScheduleSlot[]
  attendanceSessions AttendanceSession[]
  createdFees        StudentFee[]        @relation("StudentFeeCreatedBy")
  recordedPayments   Payment[]           @relation("PaymentRecordedBy")

  @@unique([userId, workspaceId])
  @@index([workspaceId])
  @@index([workspaceId, role])
  @@map("memberships")
}

model TeacherProfile {
  id              String    @id @default(uuid())
  workspaceId     String    @map("workspace_id")
  membershipId    String    @unique @map("membership_id")
  phone           String?
  qualifications  String?
  specializations String[]  @default([])
  bio             String?
  joinedAt        DateTime? @map("joined_at") @db.Date
  notes           String?
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  workspace  Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@map("teacher_profiles")
}

model WorkspaceInvitation {
  id           String           @id @default(uuid())
  workspaceId  String           @map("workspace_id")
  email        String
  role         WorkspaceRole    @default(TEACHER)
  tokenHash    String           @unique @map("token_hash")
  status       InvitationStatus @default(PENDING)
  invitedById  String           @map("invited_by_id")
  acceptedById String?          @map("accepted_by_id")
  expiresAt    DateTime         @map("expires_at")
  acceptedAt   DateTime?        @map("accepted_at")
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")

  workspace  Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedBy  User      @relation("InvitationInvitedBy", fields: [invitedById], references: [id], onDelete: Restrict)
  acceptedBy User?     @relation("InvitationAcceptedBy", fields: [acceptedById], references: [id], onDelete: SetNull)

  @@unique([workspaceId, email])
  @@index([workspaceId, status])
  @@index([email, status])
  @@map("workspace_invitations")
}

model EmailVerificationToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("email_verification_tokens")
}

/// Append-only security trail. Deliberately no relations so entries survive
/// user and workspace deletion.
model AuditEvent {
  id          String         @id @default(uuid())
  type        AuditEventType
  actorUserId String?        @map("actor_user_id")
  workspaceId String?        @map("workspace_id")
  targetId    String?        @map("target_id")
  metadata    Json?
  createdAt   DateTime       @default(now()) @map("created_at")

  @@index([workspaceId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([type, createdAt])
  @@map("audit_events")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model DatabaseHealth {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  @@map("database_health")
}

model Session {
  id                String   @id @default(uuid())
  userId            String   @map("user_id")
  tokenHash         String   @unique @map("token_hash")
  expiresAt         DateTime @map("expires_at")
  createdAt         DateTime @default(now()) @map("created_at")
  activeWorkspaceId String?  @map("active_workspace_id")

  user            User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeWorkspace Workspace? @relation("SessionActiveWorkspace", fields: [activeWorkspaceId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([expiresAt])
  @@index([activeWorkspaceId])
  @@map("sessions")
}
