generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum WorkspaceType {
  TEACHER
  INSTITUTE
}

enum WorkspaceRole {
  OWNER
  ADMIN
  BRANCH_MANAGER
  TEACHER
  STUDENT
  PARENT
}

enum MembershipStatus {
  ACTIVE
  SUSPENDED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

enum StudentStatus {
  ACTIVE
  INACTIVE
  GRADUATED
  WITHDRAWN
}

enum StudentGender {
  MALE
  FEMALE
  OTHER
}

enum GuardianRelationship {
  FATHER
  MOTHER
  GUARDIAN
  OTHER
}

enum AuditEventType {
  USER_REGISTERED
  LOGIN_SUCCEEDED
  LOGIN_FAILED
  EMAIL_VERIFIED
  EMAIL_VERIFICATION_RESENT
  PASSWORD_RESET_REQUESTED
  PASSWORD_RESET_COMPLETED
  WORKSPACE_CREATED
  WORKSPACE_SWITCHED
  MEMBER_ROLE_CHANGED
  MEMBER_REMOVED
  INVITATION_CREATED
  INVITATION_REVOKED
  INVITATION_ACCEPTED
  STUDENT_CREATED
  STUDENT_UPDATED
  STUDENT_STATUS_CHANGED
  GUARDIAN_CREATED
  GUARDIAN_UPDATED
  GUARDIAN_UNLINKED
  GUARDIAN_DELETED
  STUDENTS_IMPORTED
}

model User {
  id              String    @id @default(uuid())
  email           String    @unique
  passwordHash    String    @map("password_hash")
  firstName       String    @map("first_name")
  lastName        String?   @map("last_name")
  emailVerifiedAt DateTime? @map("email_verified_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  memberships             Membership[]
  sessions                Session[]
  invitationsSent         WorkspaceInvitation[]    @relation("InvitationInvitedBy")
  invitationsAccepted     WorkspaceInvitation[]    @relation("InvitationAcceptedBy")
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]

  @@map("users")
}

model Workspace {
  id        String        @id @default(uuid())
  name      String
  type      WorkspaceType
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")

  memberships      Membership[]
  invitations      WorkspaceInvitation[]
  students         Student[]
  guardians        Guardian[]
  studentGuardians StudentGuardian[]
  activeSessions   Session[]             @relation("SessionActiveWorkspace")

  @@map("workspaces")
}

model Student {
  id           String         @id @default(uuid())
  workspaceId  String         @map("workspace_id")
  studentCode  String?        @map("student_code")
  firstName    String         @map("first_name")
  lastName     String?        @map("last_name")
  dateOfBirth  DateTime?      @map("date_of_birth") @db.Date
  gender       StudentGender?
  email        String?
  phone        String?
  addressLine1 String?        @map("address_line1")
  addressLine2 String?        @map("address_line2")
  city         String?
  district     String?
  postalCode   String?        @map("postal_code")
  school       String?
  grade        String?
  status       StudentStatus  @default(ACTIVE)
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  guardians StudentGuardian[]

  @@unique([workspaceId, studentCode])
  @@index([workspaceId, status])
  @@index([workspaceId, firstName, lastName])
  @@map("students")
}

model Guardian {
  id           String               @id @default(uuid())
  workspaceId  String               @map("workspace_id")
  firstName    String               @map("first_name")
  lastName     String?              @map("last_name")
  relationship GuardianRelationship
  email        String?
  phone        String?
  occupation   String?
  addressLine1 String?              @map("address_line1")
  addressLine2 String?              @map("address_line2")
  city         String?
  district     String?
  postalCode   String?              @map("postal_code")
  createdAt    DateTime             @default(now()) @map("created_at")
  updatedAt    DateTime             @updatedAt @map("updated_at")

  workspace Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  students  StudentGuardian[]

  @@index([workspaceId, lastName, firstName])
  @@map("guardians")
}

model StudentGuardian {
  id          String   @id @default(uuid())
  workspaceId String   @map("workspace_id")
  studentId   String   @map("student_id")
  guardianId  String   @map("guardian_id")
  isPrimary   Boolean  @default(false) @map("is_primary")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  student   Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  guardian  Guardian  @relation(fields: [guardianId], references: [id], onDelete: Cascade)

  @@unique([studentId, guardianId])
  @@index([workspaceId])
  @@index([guardianId])
  @@map("student_guardians")
}

model Membership {
  id          String           @id @default(uuid())
  userId      String           @map("user_id")
  workspaceId String           @map("workspace_id")
  role        WorkspaceRole    @default(TEACHER)
  status      MembershipStatus @default(ACTIVE)
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  user      User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)

  @@unique([userId, workspaceId])
  @@index([workspaceId])
  @@index([workspaceId, role])
  @@map("memberships")
}

model WorkspaceInvitation {
  id           String           @id @default(uuid())
  workspaceId  String           @map("workspace_id")
  email        String
  role         WorkspaceRole    @default(TEACHER)
  tokenHash    String           @unique @map("token_hash")
  status       InvitationStatus @default(PENDING)
  invitedById  String           @map("invited_by_id")
  acceptedById String?          @map("accepted_by_id")
  expiresAt    DateTime         @map("expires_at")
  acceptedAt   DateTime?        @map("accepted_at")
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")

  workspace  Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedBy  User      @relation("InvitationInvitedBy", fields: [invitedById], references: [id], onDelete: Restrict)
  acceptedBy User?     @relation("InvitationAcceptedBy", fields: [acceptedById], references: [id], onDelete: SetNull)

  @@unique([workspaceId, email])
  @@index([workspaceId, status])
  @@index([email, status])
  @@map("workspace_invitations")
}

model EmailVerificationToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("email_verification_tokens")
}

/// Append-only security trail. Deliberately no relations so entries survive
/// user and workspace deletion.
model AuditEvent {
  id          String         @id @default(uuid())
  type        AuditEventType
  actorUserId String?        @map("actor_user_id")
  workspaceId String?        @map("workspace_id")
  targetId    String?        @map("target_id")
  metadata    Json?
  createdAt   DateTime       @default(now()) @map("created_at")

  @@index([workspaceId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([type, createdAt])
  @@map("audit_events")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model DatabaseHealth {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  @@map("database_health")
}

model Session {
  id                String   @id @default(uuid())
  userId            String   @map("user_id")
  tokenHash         String   @unique @map("token_hash")
  expiresAt         DateTime @map("expires_at")
  createdAt         DateTime @default(now()) @map("created_at")
  activeWorkspaceId String?  @map("active_workspace_id")

  user            User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeWorkspace Workspace? @relation("SessionActiveWorkspace", fields: [activeWorkspaceId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([expiresAt])
  @@index([activeWorkspaceId])
  @@map("sessions")
}
